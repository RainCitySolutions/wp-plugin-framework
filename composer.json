{
	"name" : "raincity/wp-plugin-framework",
	"description" : "Library to support implementing WordPress plugins",
	"type" : "library",
	"version" : "2.1.105",
	"license" : "BSD-3-Clause",
	"minimum-stability" : "stable",
	"repositories" : [{
			"type" : "git",
			"url" : "https://github.com/RainCitySolutions/php-library",
			"name" : "php-library"
		}
	],
	"config" : {
		"allow-plugins" : {
			"composer/installers" : true,
			"phpstan/extension-installer" : true
		}
	},
	"require" : {
		"php" : ">=8.2",
		"composer/installers" : "~2.3",
		"raincity/php-library" : "~2.1",
		"psr/log" : "~3.0",
		"deliciousbrains/wp-background-processing" : "~1.4",
		"html2text/html2text" : "~4.3"
	},
	"require-dev" : {
		"phpunit/phpunit" : "~11.5",
		"brain/monkey" : "~2.7",
		"phpstan/phpstan" : "~2.1",
		"phpstan/extension-installer" : "~1.4",
		"szepeviktor/phpstan-wordpress" : "~2.0",
		"phpstan/phpstan-deprecation-rules": "^2.0"
	},
	"autoload" : {
		"classmap" : [
			"src/"
		],
		"psr-4" : {
			"RainCity\\WPF\\" : [
				"src/RainCity/WPF",
				"test/RainCity/WPF"
			]
		}
	},
	"autoload-dev" : {
		"psr-4" : {
			"RainCity\\WPF\\" : "test/RainCity/WPF"
		}
	}
}
